{
  "name": "logickidsmobile",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:8082": "expo start --port 8082",
    "dev": "expo start -c",
    "dev:8082": "expo start --port 8082 -c",
    "dev:tunnel": "expo start --host tunnel -c",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:apk": "npx eas-cli build --platform android --profile preview",
    "build:android": "npm run build:apk",
    "build:ios": "npx eas-cli build --platform ios --profile preview",
    "build:production": "npx eas-cli build --platform all --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "expo": "~54.0.0",
    "expo-camera": "~17.0.10",
    "expo-font": "~14.0.11",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "babel-preset-expo": "^54.0.10"
  },
  "private": true
}
