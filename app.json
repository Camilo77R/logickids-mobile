{
  "expo": {
    "name": "logickidsMobile",
    "slug": "logickidsMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "LogicKids necesita la camara para escanear codigos QR de inicio de sesion."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.camilosr.logickidsmobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "LogicKids necesita la camara para escanear codigos QR de inicio de sesion.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-video"
    ],
    "extra": {
      "qrLoginPath": "/estudiantes/login",
      "studentProfilePath": "/estudiantes/mi-perfil",
      "eas": {
        "projectId": "2b38a483-2833-421a-8bb1-b56bbfbfb76a"
      }
    }
  }
}
